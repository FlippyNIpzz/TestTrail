-- Fixtures exercise configurable content beyond the shipped example.
CurrencyConfig.Definitions["currency.gems"] = { DisplayName = "Gems", StartingBalance = 0, Precision = 2 }
InventoryConfig.Definitions["item.tool"] = { DisplayName = "Tool", Kind = "Unique", Properties = {
    Quality = { Type = "number", Min = 1, Max = 10, Default = 1 },
    Label = { Type = "string", MaxLength = 20, Default = "Tool" },
    Bound = { Type = "boolean", Default = false },
} }
local passed = 0
local function test(name, callback)
    local ok, reason = pcall(callback)
    assert(ok, name .. ": " .. tostring(reason))
    passed += 1; print("PASS " .. name)
end
local function player(id)
    return { UserId = id, Parent = Players, Attributes = {}, SetAttribute = function(self, key, value) self.Attributes[key] = value end,
        GetAttribute = function(self, key) return self.Attributes[key] end }
end
test("invalid currency precision stops validation", function()
    CurrencyConfig.Definitions["currency.invalid"] = { DisplayName = "Invalid", StartingBalance = 0, Precision = 0.5 }
    assert(not pcall(CurrencyHelpers.ValidateConfig))
    CurrencyConfig.Definitions["currency.invalid"] = nil
end)
test("invalid sale references stop validation", function()
    InventoryConfig.Definitions["product.bad"] = { DisplayName = "Bad", Kind = "Stackable", Sell = { CurrencyId = "currency.missing", UnitPrice = 1 } }
    assert(not pcall(InventoryHelpers.ValidateConfig))
    InventoryConfig.Definitions["product.bad"] = nil
end)
PlayerDataService.Initialize({}); CurrencyService.Initialize({}); InventoryService.Initialize({}); UIService.Initialize({})
test("validated catalogs are recursively frozen", function()
    assert(table.isfrozen(CurrencyConfig) and table.isfrozen(CurrencyConfig.Definitions["currency.cash"]))
    assert(table.isfrozen(InventoryConfig) and table.isfrozen(InventoryConfig.Definitions["item.tool"].Properties.Quality))
end)
local alice, bob = player(1), player(2)
assert(PlayerDataService.Load(alice)); assert(PlayerDataService.Load(bob))
local function balance(who, id)
    local ok, value = CurrencyService.GetBalance(who, id or "currency.cash"); assert(ok); return value
end
local function inventory(who)
    local ok, value = InventoryService.GetInventory(who); assert(ok); return value
end
local function sale(id, quantity, requestId)
    return InventoryService.Sell(alice, id, quantity, requestId or InventoryService.GetNextSellRequestId(alice))
end

test("multiple currencies and precision", function()
    assert(CurrencyService.Grant(alice, "currency.cash", 100))
    assert(CurrencyService.Grant(alice, "currency.gems", 1.25))
    assert(not CurrencyService.Grant(alice, "currency.cash", 0.5))
    assert(not CurrencyService.Grant(alice, "currency.cash", 0.000000001))
    assert(not CurrencyService.Grant(alice, "currency.gems", 0.001))
    assert(CurrencyService.Spend(alice, { ["currency.gems"] = 0.25 }))
    assert(balance(alice, "currency.gems") == 1)
end)
test("nonfinite negative zero and unknown currency rejected", function()
    for _, amount in { -1, 0, math.huge, 0/0, 9007199254740992 } do
        assert(not CurrencyService.Grant(alice, "currency.cash", amount))
    end
    assert(not CurrencyService.Grant(alice, "currency.missing", 1))
    assert(balance(alice) == 100)
end)
test("multi-currency spend validates all costs before deductions", function()
    assert(not CurrencyService.Spend(alice, { ["currency.cash"] = 10, ["currency.gems"] = 2 }))
    assert(not CurrencyService.Spend(alice, { ["currency.cash"] = 10, ["currency.bad"] = 0 }))
    assert(balance(alice) == 100 and balance(alice, "currency.gems") == 1)
    assert(CurrencyService.Spend(alice, { ["currency.cash"] = 20, ["currency.gems"] = 0.5 }))
    assert(balance(alice) == 80 and balance(alice, "currency.gems") == 0.5)
    assert(CurrencyService.Spend(alice, {}))
end)
test("stack grants and capacity enforce whole quantities", function()
    assert(InventoryService.Grant(alice, "resource.ore", 990))
    assert(not InventoryService.Grant(alice, "product.ingot", 11))
    assert(InventoryService.Grant(alice, "product.ingot", 10))
    for _, amount in { -1, 0, 0.5, math.huge, 0/0 } do assert(not InventoryService.Grant(alice, "resource.ore", amount)) end
    assert(not InventoryService.Grant(alice, "resource.ore", 1, { forged = true }))
    assert(inventory(alice).Stacks["resource.ore"] == 990)
end)
test("oversized remove and invalid IDs preserve ownership", function()
    assert(not InventoryService.Remove(alice, "product.ingot", 11))
    assert(not InventoryService.Remove(alice, "product.fake", 1))
    local ok, has = InventoryService.Has(alice, "product.ingot", 10); assert(ok and has)
    assert(InventoryService.Remove(alice, "resource.ore", 990))
    assert(inventory(alice).Stacks["resource.ore"] == nil)
end)
test("sell selected quantity atomically", function()
    assert(sale("product.ingot", 3))
    assert(inventory(alice).Stacks["product.ingot"] == 7 and balance(alice) == 110)
    assert(balance(bob) == 0 and next(inventory(bob).Stacks) == nil)
end)
test("duplicate request returns result without selling twice", function()
    local id = InventoryService.GetNextSellRequestId(alice)
    assert(sale("product.ingot", 2, id)); assert(sale("product.ingot", 2, id))
    assert(inventory(alice).Stacks["product.ingot"] == 5 and balance(alice) == 130)
    local ok, reason = sale("product.ingot", 1, id)
    assert(not ok and reason == "RequestIdConflict")
end)
test("old and out-of-order requests never execute", function()
    local old = InventoryService.GetNextSellRequestId(alice) - 1
    assert(sale("product.ingot", 1))
    assert(not sale("product.ingot", 2, old))
    assert(not sale("product.ingot", 1, 9999))
    assert(inventory(alice).Stacks["product.ingot"] == 4 and balance(alice) == 140)
end)
test("malformed sale quantities and IDs cannot change state", function()
    for _, amount in { 0, -1, 0.5, math.huge, 0/0, 1001 } do assert(not sale("product.ingot", amount)) end
    assert(not sale({}, 1)); assert(not sale("product.ingot", 1, 0))
    assert(not sale("resource.ore", 1))
    assert(not sale("product.ingot", 5))
    assert(balance(alice) == 140 and inventory(alice).Stacks["product.ingot"] == 4)
end)
test("reward overflow rolls back consumed items", function()
    assert(PlayerDataService.Update(alice, function(data) data.Currencies["currency.cash"] = 9007199254740991 end))
    local ok, reason = sale("product.ingot", 1)
    assert(not ok and reason == "BalanceLimit")
    assert(inventory(alice).Stacks["product.ingot"] == 4 and balance(alice) == 9007199254740991)
    assert(PlayerDataService.Update(alice, function(data) data.Currencies["currency.cash"] = 140 end))
end)
test("unique items get separate IDs and validated properties", function()
    local ok, first = InventoryService.Grant(alice, "item.tool", 1, { Quality = 7 })
    assert(ok and type(first) == "string")
    local secondOK, second = InventoryService.Grant(alice, "item.tool", 1)
    assert(secondOK and first ~= second)
    local items = inventory(alice).Unique
    assert(items[first].Properties.Quality == 7 and items[second].Properties.Quality == 1)
    assert(not InventoryService.Grant(alice, "item.tool", 2))
    assert(not InventoryService.Grant(alice, "item.tool", 1, { Quality = 11 }))
    assert(not InventoryService.Grant(alice, "item.tool", 1, { Unknown = true }))
    assert(not InventoryService.Grant(alice, "item.tool", 1, { Label = string.rep("x", 21) }))
    assert(not InventoryService.Remove(alice, first, 2))
    assert(InventoryService.Remove(alice, first, 1))
    assert(not InventoryService.Remove(alice, first, 1))
end)
test("duplicate unique instance IDs and full capacity rejected", function()
    local draft = { Stacks = {}, Unique = {} }
    assert(InventoryHelpers.ApplyGrant(draft, "item.tool", 1, "fixed", {}))
    assert(not InventoryHelpers.ApplyGrant(draft, "item.tool", 1, "fixed", {}))
    for i = 2, InventoryConfig.MaxUniqueItems do assert(InventoryHelpers.ApplyGrant(draft, "item.tool", 1, tostring(i), {})) end
    assert(not InventoryHelpers.ApplyGrant(draft, "item.tool", 1, "overflow", {}))
end)
test("UI projection excludes private sections and item properties", function()
    assert(PlayerDataService.Update(alice, function(data) data.Features.Private = { secret = "hidden" } end))
    local ok, state = UIService.GetVisibleState(alice)
    assert(ok and state.Features == nil and state.Base == nil and state.SchemaVersion == nil)
    assert(state.Unique[1].Properties == nil and state.NextSellRequestId == InventoryService.GetNextSellRequestId(alice))
    state.Balances[1].Amount = -1
    assert(balance(alice) == 140)
end)
test("saved inventory capacity and unique properties revalidated", function()
    local data = PlayerDataSchema.New()
    data.Inventory.Stacks["resource.ore"] = InventoryConfig.MaxStackUnits + 1
    local ok, normalized, resets = PlayerDataSchema.Prepare(data)
    assert(ok and #resets == 1 and next(normalized.Inventory.Stacks) == nil)
    data = PlayerDataSchema.New()
    data.Inventory.Unique["forged"] = { DefinitionId = "item.tool", Properties = { Quality = 999 } }
    local valid, _, reset = PlayerDataSchema.Prepare(data)
    assert(valid and #reset == 1 and reset[1] == "Inventory")
end)
test("sale before admission is rejected", function()
    local visitor = player(3)
    assert(not InventoryService.Sell(visitor, "product.ingot", 1, 1))
    assert(not CurrencyService.Grant(visitor, "currency.cash", 1))
    assert(not InventoryService.Grant(visitor, "product.ingot", 1))
end)
test("admin sales switch rejects new sales and preserves completed retries", function()
    local id = InventoryService.GetNextSellRequestId(alice)
    assert(InventoryService.Sell(alice, "product.ingot", 1, id))
    local cash, units = balance(alice), inventory(alice).Stacks["product.ingot"]
    assert(InventoryService.SetSalesEnabled(false) and not InventoryService.GetSalesEnabled())
    local ok, why = InventoryService.Sell(alice, "product.ingot", 1, id + 1)
    assert(not ok and why == "SellingDisabled")
    assert(InventoryService.Sell(alice, "product.ingot", 1, id))
    assert(balance(alice) == cash and inventory(alice).Stacks["product.ingot"] == units)
    assert(not InventoryService.SetSalesEnabled("yes")); assert(InventoryService.SetSalesEnabled(true))
    assert(InventoryService.Sell(alice, "product.ingot", 1, id + 1))
end)
UIService.Destroy(); InventoryService.Destroy(); CurrencyService.Destroy(); PlayerDataService.Destroy()
print(tostring(passed) .. " economy tests passed")
